{{!
    @template report_sphorphanedfiles/sectionTable

    Moodle template competency breakdown report.

    This template includes ajax functionality, so it cannot be shown in the template library.
}}

<table class="table table-hover table-bordered">
    <thead class='orphandfilesth'>
    <tr>
        <th scope="col">{{translation.header.modName}}</th>
        <th scope="col">{{translation.header.content}}</th>
        <th scope="col">{{translation.header.filename}}</th>
        <th scope="col">{{translation.header.preview}}</th>
        <th scope="col">{{translation.header.tool}}</th>
    </tr>
    </thead>
    <tbody>
    {{#orphanedFiles}}
        <tr>
            <td>{{modName}}<br> <img src="http://localhost:8000/theme/image.php/hla/core/1631091674/f/jpeg-24" class=“activityicon” alt=“{{modName}}” />{{name}}</td>
            <td><details><summary></summary>Quelltext:<textarea style="width: 100%;" rows="4">{{content}}</textarea></details>{{{content}}}</td>
            <td>{{{filename}}}</td>
            <td>{{{preview}}}</td>
            <td>
                {{#userAllowedToDelete}}
                    <form action="#" method="POST">
                        <input type="hidden" name="filearea" value="{{formDelete.filearea}}">
                        <input type="hidden" name="itemId" value="{{formDelete.itemId}}">
                        <input type="hidden" name="contextId" value="{{formDelete.contextId}}">
                        <input type="hidden" name="filepath" value="{{formDelete.filepath}}">
                        <input type="hidden" name="filename" value="{{formDelete.filename}}">
                        <input type="hidden" name="component" value="{{formDelete.component}}">
                        <div>
                            <button class="btn btn-sm btn-danger p-1"><i class="fa fa-trash fa-fw h4 m-b-0"></i>
                            </button>
                        </div>
                    </form>
                {{/userAllowedToDelete}}
                {{^userAllowedToDelete}}
                    No
                {{/userAllowedToDelete}}
            </td>
        </tr>
    {{/orphanedFiles}}








    </tbody>
</table>
