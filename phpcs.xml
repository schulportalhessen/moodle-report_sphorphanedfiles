<?xml version="1.0"?>
<ruleset name="Custom Moodle Ruleset">
    <description>My custom coding standard for Moodle plugin</description>

    <!-- Moodle standard als Basis -->
    <rule ref="moodle">
        <!-- Deaktiviert die Regel zu Kleinbuchstaben bei Variablennamen -->
        <exclude name="moodle.NamingConventions.ValidVariableName.VariableNameLowerCase"/>
        <!-- Erlaubt CamelCase für public method names -->
        <exclude name="moodle.NamingConventions.ValidFunctionName.PublicUnderscore"/>

        <exclude name="moodle.NamingConventions.ValidVariableName.MemberNameUnderscore"/>
        <exclude name="moodle.NamingConventions.ValidFunctionName.LowercaseMethod"/>
        <exclude name="moodle.Commenting.MissingDocblock.Function"/>
        <exclude name="moodle.Commenting.VariableComment.Missing"/>

    </rule>

    <!-- Analysiere das Plugin-Verzeichnis -->
    <file>./</file>
</ruleset>